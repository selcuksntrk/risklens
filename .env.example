# Only server-side. Never put keys in VITE_* variables.
MODEL_API_KEY=
SPARK_MODEL=muse-spark-1.3
# Local HTTP: 0; HTTPS production: 1 (Modal configuration enforces 1).
RISKLENS_COOKIE_SECURE=0
RISKLENS_MAX_USD_PER_DAY=15
# Raw media: 7 days; reports and evidence: 30 days.
RISKLENS_RETENTION_DAYS=7
RISKLENS_REPORT_RETENTION_DAYS=30
